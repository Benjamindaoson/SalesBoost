# ============================================================================
# SalesAgent V3 Environment Configuration
# Generated: 2026-03-03
# ============================================================================

#  Application
APP_NAME=SalesAgent
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

#  Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salesagent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

#  Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
WORKING_MEMORY_TTL_SECONDS=7200

#  OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

#  Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key

#  DeepSeek API (Optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

#  Model Configuration
# Primary models
PRIMARY_REASONING_MODEL=gpt-4o
PRIMARY_RESPONSE_MODEL=gpt-4o
PRIMARY_GUARD_MODEL=gpt-4o-mini

# Fallback models
FALLBACK_REASONING_MODEL=gpt-4o-mini
FALLBACK_RESPONSE_MODEL=gpt-4o-mini
FALLBACK_GUARD_MODEL=gpt-3.5-turbo

# Model parameters
REASONING_TEMPERATURE=0.7
RESPONSE_TEMPERATURE=0.8
GUARD_TEMPERATURE=0.3
MAX_TOKENS=2000

#  RAG Configuration
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

#  Guard Configuration
GUARD_ENABLED=true
GUARD_REWRITE_ENABLED=true
GUARD_SENTENCE_BUFFER_SIZE=3

#  Memory Configuration
REASONING_CACHE_ENABLED=true
REASONING_CACHE_TTL_SECONDS=3600
MEMORY_DECAY_HALF_LIFE_DAYS=7

#  Flywheel Configuration
APO_ENABLED=true
APO_VARIANT_COUNT=3
APO_MIN_EVALUATIONS=10
SHADOW_MODE_TRAFFIC_PERCENTAGE=10

#  WeChat Configuration (Personal)
WECHAT_PERSONAL_ENABLED=true
WECHAT_PERSONAL_AUTO_LOGIN=true
WECHAT_PERSONAL_QR_CALLBACK_URL=
WECHAT_PERSONAL_HOT_RELOAD=true
WECHAT_PERSONAL_SESSION_FILE=.wechat_session.pkl

#  WeChat Work Configuration (Enterprise)
WECHAT_WORK_ENABLED=false
WECHAT_WORK_CORP_ID=
WECHAT_WORK_AGENT_ID=
WECHAT_WORK_SECRET=
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
WECHAT_WORK_WEBHOOK_URL=https://your-domain.com/api/wechat/webhook

#  Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

#  Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=5000

#  Observability
# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=salesagent-v3

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

#  CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

#  MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=salesagent
MINIO_SECURE=false

#  Feature Flags
FEATURE_SIMULATION_NODE=true
FEATURE_CRITIC_NODE=true
FEATURE_HOT_PATH_ROUTING=true
FEATURE_HITL_INTERRUPT=true

#  Performance Tuning
ASYNC_WORKER_COUNT=4
MAX_CONCURRENT_SESSIONS=100
REQUEST_TIMEOUT_SECONDS=120
SSE_KEEPALIVE_INTERVAL_SECONDS=15

#  Development Tools
RELOAD_ON_CHANGE=true
SHOW_SQL_QUERIES=false
ENABLE_API_DOCS=true
