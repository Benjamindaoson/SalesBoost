# Figma API 配置
# 从 Figma 导出设计资源时需要这些配置

# Figma Personal Access Token
# 获取方式: https://www.figma.com/developers/api#access-tokens
VITE_FIGMA_TOKEN=your_figma_token_here

# Figma File Key
# 获取方式: 打开 Figma 文件,从 URL 中复制
# 例如: https://www.figma.com/file/FILE_KEY/FILE_NAME
VITE_FIGMA_FILE_KEY=your-file-key-here

# 导出配置
VITE_FIGMA_EXPORT_FORMAT=png
VITE_FIGMA_EXPORT_SCALE=2
